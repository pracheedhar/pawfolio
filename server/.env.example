PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/pawfolio
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
UPLOAD_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SEED_ADMIN_EMAIL=admin@pawfolio.example
SEED_USER_EMAIL=ocean@pawfolio.example
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# Hosting proxy count; Vercel + Render uses 2, local development uses 0.
TRUST_PROXY_HOPS=0
# One-time production setup only; remove ADMIN_PASSWORD after setup.
ADMIN_EMAIL=
ADMIN_NAME=Pawfolio Admin
ADMIN_PASSWORD=

# Shared private Vercel/Render secret; required in production, omit locally.
# PROXY_SECRET=replace-with-another-random-secret-at-least-32-characters
